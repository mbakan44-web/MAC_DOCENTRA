<Page x:Class="PromtAiPdfPro.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Ayarlar"
      Loaded="SettingsPage_Loaded">

    <Viewbox Stretch="Uniform" VerticalAlignment="Top" HorizontalAlignment="Center">
        <Grid Width="1150" Height="820" Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Click="BtnBack_Click" Padding="8" VerticalAlignment="Center" Margin="0,0,20,0" ToolTip="{DynamicResource Common_Back}">
                    <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="24"/>
                </ui:Button>
                <TextBlock Grid.Column="1" Text="{DynamicResource Sett_Title}" FontSize="36" FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>

            <!-- Settings Content -->
            <StackPanel Grid.Row="1">
                
                <!-- 1. Dil Ayarları -->
                <ui:Card Padding="24" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="LocalLanguage24" FontSize="32" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Sett_LangTitle}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{DynamicResource Sett_LangDesc}" Opacity="0.6"/>
                        </StackPanel>
                        <ComboBox x:Name="CboLanguage" Grid.Column="2" Width="300" VerticalAlignment="Center" SelectionChanged="CboLanguage_SelectionChanged">
                            <ComboBoxItem Content="English (English)" Tag="en-US"/>
                            <ComboBoxItem Content="Türkçe (Turkish)" Tag="tr-TR"/>
                            <ComboBoxItem Content="Español (Spanish)" Tag="es-ES"/>
                            <ComboBoxItem Content="Deutsch (German)" Tag="de-DE"/>
                            <ComboBoxItem Content="Français (French)" Tag="fr-FR"/>
                            <ComboBoxItem Content="Italiano (Italian)" Tag="it-IT"/>
                            <ComboBoxItem Content="Русский (Russian)" Tag="ru-RU"/>
                            <ComboBoxItem Content="العربية (Arabic)" Tag="ar-SA"/>
                            <ComboBoxItem Content="中文 (Chinese)" Tag="zh-CN"/>
                            <ComboBoxItem Content="日本語 (Japanese)" Tag="ja-JP"/>
                            <ComboBoxItem Content="{DynamicResource Sett_AutoLang}" Tag="Auto"/>
                        </ComboBox>
                    </Grid>
                </ui:Card>

                <!-- 2. Tema Ayarları -->
                <ui:Card Padding="24" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="PaintBrush24" FontSize="32" Margin="0,5,20,0" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{DynamicResource Sett_ThemeTitle}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{DynamicResource Sett_ThemeDesc}" Opacity="0.6" Margin="0,0,0,20"/>
                            
                            <WrapPanel x:Name="ThemePanel">
                                <!-- Dark -->
                                <Border x:Name="ThemeCard_Dark" Tag="Dark" Width="135" Height="100" Background="#1E1E1E" CornerRadius="12" Margin="0,0,15,15" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand" MouseLeftButtonDown="ThemeCard_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <Ellipse Fill="#0078D4" Width="24" Height="24" Margin="0,0,0,8"/>
                                        <TextBlock Text="{DynamicResource Theme_Dark}" HorizontalAlignment="Center" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <!-- Light -->
                                <Border x:Name="ThemeCard_Light" Tag="Light" Width="135" Height="100" Background="#F3F3F3" CornerRadius="12" Margin="0,0,15,15" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand" MouseLeftButtonDown="ThemeCard_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <Ellipse Fill="#0063B1" Width="24" Height="24" Margin="0,0,0,8"/>
                                        <TextBlock Text="{DynamicResource Theme_Light}" HorizontalAlignment="Center" Foreground="#333" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <!-- Pastel Blue -->
                                <Border x:Name="ThemeCard_PastelBlue" Tag="PastelBlue" Width="135" Height="100" Background="#E3F2FD" CornerRadius="12" Margin="0,0,15,15" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand" MouseLeftButtonDown="ThemeCard_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <Ellipse Fill="#2196F3" Width="24" Height="24" Margin="0,0,0,8"/>
                                        <TextBlock Text="{DynamicResource Theme_PastelBlue}" HorizontalAlignment="Center" Foreground="#1976D2" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <!-- Lavender -->
                                <Border x:Name="ThemeCard_Lavender" Tag="Lavender" Width="135" Height="100" Background="#F3E5F5" CornerRadius="12" Margin="0,0,15,15" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand" MouseLeftButtonDown="ThemeCard_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <Ellipse Fill="#9C27B0" Width="24" Height="24" Margin="0,0,0,8"/>
                                        <TextBlock Text="{DynamicResource Theme_Lavender}" HorizontalAlignment="Center" Foreground="#7B1FA2" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <!-- Mint -->
                                <Border x:Name="ThemeCard_Mint" Tag="Mint" Width="135" Height="100" Background="#E8F5E9" CornerRadius="12" Margin="0,0,15,15" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand" MouseLeftButtonDown="ThemeCard_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <Ellipse Fill="#4CAF50" Width="24" Height="24" Margin="0,0,0,8"/>
                                        <TextBlock Text="{DynamicResource Theme_Mint}" HorizontalAlignment="Center" Foreground="#2E7D32" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <!-- Apricot -->
                                <Border x:Name="ThemeCard_Apricot" Tag="Apricot" Width="135" Height="100" Background="#FFF1D7" CornerRadius="12" Margin="0,0,15,15" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand" MouseLeftButtonDown="ThemeCard_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <Ellipse Fill="#FFC107" Width="24" Height="24" Margin="0,0,0,8"/>
                                        <TextBlock Text="{DynamicResource Theme_Apricot}" HorizontalAlignment="Center" Foreground="#F57F17" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <!-- High Contrast -->
                                <Border x:Name="ThemeCard_HighContrast" Tag="HighContrast" Width="135" Height="100" Background="Black" CornerRadius="12" Margin="0,0,15,15" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand" MouseLeftButtonDown="ThemeCard_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <Ellipse Fill="White" Width="24" Height="24" Margin="0,0,0,8"/>
                                        <TextBlock Text="{DynamicResource Theme_HighContrast}" HorizontalAlignment="Center" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- 3. Kayıt Klasörü -->
                <ui:Card Padding="24" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Folder24" FontSize="32" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Sett_DefaultPath}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{DynamicResource Sett_DefaultPathDesc}" Opacity="0.6"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:TextBox x:Name="TxtDefaultPath" Width="200" IsReadOnly="True" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <ui:Button Content="{DynamicResource Common_Select}" Click="BtnSelectPath_Click" Width="80" Height="36"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- Varsayılan Uygulama ve İkon Kaydı -->
                <ui:Card Padding="24" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="32" Margin="0,0,20,0" VerticalAlignment="Center" Foreground="{DynamicResource PremiumAccentBrush}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Sett_DefaultReaderTitle}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{DynamicResource Sett_DefaultReaderDesc}" Opacity="0.6"/>
                        </StackPanel>
                        <ui:Button Grid.Column="2" Content="{DynamicResource Sett_BtnSetDefault}" Click="BtnRegisterDefault_Click" Appearance="Primary" VerticalAlignment="Center"/>
                    </Grid>
                </ui:Card>

                <!-- 4. Temizlik Modu -->
                <ui:Card Padding="24" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Delete24" FontSize="32" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Sett_CleanMode}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{DynamicResource Sett_CleanModeDesc}" Opacity="0.6"/>
                        </StackPanel>
                        <ui:Button Grid.Column="2" Content="{DynamicResource Sett_BtnClean}" Click="BtnClean_Click" Appearance="Secondary" VerticalAlignment="Center"/>
                    </Grid>
                </ui:Card>

                <!-- 5. Uygulama Hakkında -->
                <ui:Card Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Info24" FontSize="32" Margin="0,5,20,0" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{DynamicResource Sett_About}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{DynamicResource Sett_Version}" Margin="0,5,0,0"/>
                            <TextBlock Text="{DynamicResource Sett_Author}"/>
                            <TextBlock Text="{DynamicResource Sett_Website}" Foreground="#0078D4" Cursor="Hand" MouseLeftButtonUp="BtnWebsite_Click"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>
            </StackPanel>

            <!-- Save Button -->
            <ui:Button Grid.Row="2" Click="BtnSave_Click" Appearance="Primary" Background="#2E7D32" Width="200" Height="50" HorizontalAlignment="Left" Margin="0,20,0,0">
                <TextBlock Text="{DynamicResource Sett_Save}" FontSize="18" FontWeight="Bold"/>
            </ui:Button>

        </Grid>
    </Viewbox>
</Page>
