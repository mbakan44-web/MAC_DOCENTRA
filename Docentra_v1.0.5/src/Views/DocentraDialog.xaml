<Window x:Class="PromtAiPdfPro.Views.DocentraDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Docentra"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        MinWidth="380"
        MaxWidth="520">

    <Border Margin="16"
            Background="#1E232A"
            BorderBrush="#384252"
            BorderThickness="1.5"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with Icon & Title -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBadge"
                        Grid.Column="0"
                        Width="44" Height="44"
                        CornerRadius="12"
                        Background="#2B3545"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtIconSymbol"
                               Text="ℹ️"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="TxtTitle"
                           Grid.Column="1"
                           Text="Docentra"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>

            <!-- Content Message -->
            <TextBlock x:Name="TxtMessage"
                       Grid.Row="1"
                       Text="Message text here"
                       FontSize="14"
                       Foreground="#CBD5E1"
                       LineHeight="20"
                       TextWrapping="Wrap"
                       Margin="4,0,4,24"/>

            <!-- Buttons Row -->
            <StackPanel x:Name="ButtonPanel"
                        Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                
                <Button x:Name="BtnCancel"
                        Content="İptal"
                        MinWidth="90" Height="36"
                        Margin="8,0,0,0"
                        Background="#2D3748"
                        Foreground="#E2E8F0"
                        BorderBrush="#4A5568"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="BtnCancel_Click"
                        Visibility="Collapsed"/>

                <Button x:Name="BtnNo"
                        Content="Hayır"
                        MinWidth="90" Height="36"
                        Margin="8,0,0,0"
                        Background="#2D3748"
                        Foreground="#E2E8F0"
                        BorderBrush="#4A5568"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="BtnNo_Click"
                        Visibility="Collapsed"/>

                <Button x:Name="BtnYes"
                        Content="Evet"
                        MinWidth="90" Height="36"
                        Margin="8,0,0,0"
                        Background="#0078D4"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="BtnYes_Click"
                        Visibility="Collapsed"/>

                <Button x:Name="BtnOk"
                        Content="Tamam"
                        MinWidth="96" Height="36"
                        Margin="8,0,0,0"
                        Background="#0078D4"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="BtnOk_Click"
                        Visibility="Visible"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
