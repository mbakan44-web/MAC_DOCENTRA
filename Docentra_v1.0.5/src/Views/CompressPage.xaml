<Page x:Class="PromtAiPdfPro.Views.CompressPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{DynamicResource Nav_Compress}"
      >
    <Viewbox Stretch="Uniform" VerticalAlignment="Top" HorizontalAlignment="Center">

    <Grid Margin="48,32" Width="1150" Height="820">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Click="BtnBack_Click" Margin="0,0,16,0" Padding="8" VerticalAlignment="Center" ToolTip="{DynamicResource Common_Back}">
                <ui:SymbolIcon Symbol="ArrowLeft24"/>
            </ui:Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Compress_Title}" Style="{StaticResource PremiumHeaderTitle}"/>
                <TextBlock Text="{DynamicResource Compress_Desc}" FontSize="16" Opacity="0.7" Margin="0,0,0,16"/>
            </StackPanel>
        </Grid>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                
                <!-- Main Selection Card -->
                <ui:CardAction Margin="0,0,0,24" Padding="32" Click="BtnBrowse_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <ui:SymbolIcon Grid.Column="0" Symbol="ArrowMinimize24" FontSize="48" Foreground="#0078D4" Margin="0,0,24,0"/>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Compress_SelectFile}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtSourceFile" Text="{DynamicResource Common_PathPlaceholder}" FontSize="14" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        
                        <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" FontSize="24" Foreground="Gray" VerticalAlignment="Center"/>
                    </Grid>
                </ui:CardAction>
                
                <!-- PDF Preview Area -->
                <Border x:Name="PreviewContainer" Visibility="Collapsed" Margin="0,0,0,24" CornerRadius="12" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" Height="220">
                    <Grid>
                        <Image x:Name="ImgPreview" Margin="12" Stretch="Uniform" Effect="{DynamicResource DropShadowEffect}"/>
                        <ui:SymbolIcon Symbol="Eye24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" Opacity="0.3" FontSize="24"/>
                    </Grid>
                </Border>

                <!-- Compression Level Selection -->
                <TextBlock Text="{DynamicResource Compress_LevelTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                
                <Grid Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Low -->
                    <ui:CardAction x:Name="CardLow" Grid.Column="0" Margin="0,0,8,0" Padding="16" Click="CardLevel_Click" Tag="Low" BorderBrush="{DynamicResource PremiumAccentBrush}" BorderThickness="2">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Checkmark24" Foreground="#27AE60" HorizontalAlignment="Right" Margin="0,-8,-8,0" Visibility="Visible" x:Name="IconLow"/>
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="32" Foreground="#27AE60" Margin="0,0,0,12"/>
                            <TextBlock Text="{DynamicResource Compress_LevelLow}" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="{DynamicResource Compress_LevelLowDesc}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ui:CardAction>

                    <!-- Medium -->
                    <ui:CardAction x:Name="CardMed" Grid.Column="1" Margin="4,0,4,0" Padding="16" Click="CardLevel_Click" Tag="Medium">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Checkmark24" Foreground="#27AE60" HorizontalAlignment="Right" Margin="0,-8,-8,0" Visibility="Collapsed" x:Name="IconMed"/>
                            <ui:SymbolIcon Symbol="ArrowSort24" FontSize="32" Foreground="#0078D4" Margin="0,0,0,12"/>
                            <TextBlock Text="{DynamicResource Compress_LevelMed}" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="{DynamicResource Compress_LevelMedDesc}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ui:CardAction>

                    <!-- High -->
                    <ui:CardAction x:Name="CardHigh" Grid.Column="2" Margin="8,0,0,0" Padding="16" Click="CardLevel_Click" Tag="High">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Checkmark24" Foreground="#27AE60" HorizontalAlignment="Right" Margin="0,-8,-8,0" Visibility="Collapsed" x:Name="IconHigh"/>
                            <ui:SymbolIcon Symbol="Flash24" FontSize="32" Foreground="#E67E22" Margin="0,0,0,12"/>
                            <TextBlock Text="{DynamicResource Compress_LevelHigh}" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="{DynamicResource Compress_LevelHighDesc}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ui:CardAction>
                </Grid>

                <!-- Action Button -->
                <ui:Button x:Name="BtnCompress" Click="BtnCompress_Click" Height="60" Width="260" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <ui:Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0078D4" Offset="0"/>
                            <GradientStop Color="#2980B9" Offset="1"/>
                        </LinearGradientBrush>
                    </ui:Button.Background>
                    <ui:Button.Content>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Flash24" Foreground="White" Margin="0,0,12,0" FontSize="24" VerticalAlignment="Center" Filled="True"/>
                            <TextBlock Text="{DynamicResource Compress_ProcessBtn}" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button.Content>
                    <ui:Button.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.3" ShadowDepth="3" Color="#0078D4"/>
                    </ui:Button.Effect>
                </ui:Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    </Viewbox>
</Page>
