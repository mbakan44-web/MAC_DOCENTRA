<Page x:Class="PromtAiPdfPro.Views.MetadataEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:PromtAiPdfPro.Views"
      Title="MetadataEditorPage"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="0,0,0,20">
        <!-- ScrollViewer for content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
            <StackPanel MaxWidth="800" Margin="24,24,24,24">
                
                <!-- File Selection Area -->
                <ui:CardAction x:Name="FileDropArea" Icon="DocumentPdf24" 
                               Click="BtnSelectFile_Click"
                               AllowDrop="True" Drop="FileDropArea_Drop"
                               Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Tool_SelectFile}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtSelectedFile" Text="{DynamicResource Tool_SelectFileDesc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ui:Button Grid.Column="1" Icon="FolderOpen24" Content="{DynamicResource Tool_Browse}" Appearance="Primary" Margin="16,0,0,0"/>
                    </Grid>
                </ui:CardAction>
                
                <StackPanel x:Name="SettingsPanel" IsEnabled="False">
                    <!-- Title -->
                    <TextBlock Text="{DynamicResource Metadata_Title}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ui:TextBox x:Name="TxtTitle" Margin="0,0,0,16" PlaceholderText="Document Title"/>
                    
                    <!-- Author -->
                    <TextBlock Text="{DynamicResource Metadata_Author}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ui:TextBox x:Name="TxtAuthor" Margin="0,0,0,16" PlaceholderText="Document Author"/>
                    
                    <!-- Subject -->
                    <TextBlock Text="{DynamicResource Metadata_Subject}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ui:TextBox x:Name="TxtSubject" Margin="0,0,0,16" PlaceholderText="Document Subject"/>
                    
                    <!-- Keywords -->
                    <TextBlock Text="{DynamicResource Metadata_Keywords}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ui:TextBox x:Name="TxtKeywords" Margin="0,0,0,16" PlaceholderText="Keywords (comma separated)"/>
                    
                    <!-- Creator -->
                    <TextBlock Text="{DynamicResource Metadata_Creator}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ui:TextBox x:Name="TxtCreator" Margin="0,0,0,16" PlaceholderText="Creator Application"/>
                    
                    <!-- Producer -->
                    <TextBlock Text="{DynamicResource Metadata_Producer}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ui:TextBox x:Name="TxtProducer" Margin="0,0,0,16" PlaceholderText="PDF Producer"/>
                    
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Metadata_CreationDate}" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="TxtCreationDate" Text="-" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Metadata_ModificationDate}" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="TxtModificationDate" Text="-" />
                        </StackPanel>
                    </Grid>

                    <ui:Button x:Name="BtnSave" Content="{DynamicResource Metadata_SaveBtn}" Icon="Save24" Appearance="Primary" HorizontalAlignment="Stretch" Height="40" Click="BtnSave_Click"/>
                </StackPanel>
                
                <ui:ProgressRing x:Name="LoadingRing" IsIndeterminate="True" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,24,0,0" Height="40" Width="40"/>
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
