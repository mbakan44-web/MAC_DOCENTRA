    <x:String x:Key="Sec_SelectPdf">PDF Dosyası Seçin</x:String>
    <!-- Ayarlar ekstra -->


    <!-- PDF Viewer -->
    <x:String x:Key="PdfViewer_Title">PDF Görüntüleyici</x:String>
    <x:String x:Key="PdfViewer_Desc">PDF belgelerinizi sorunsuz bir okuyucuda analiz edin ve açın.</x:String>
    <x:String x:Key="PdfViewer_Open">PDF Aç</x:String>
    <x:String x:Key="PdfViewer_NoFile">Dosya seçilmedi</x:String>
    <x:String x:Key="PdfViewer_EmptyTitle">Belge Yüklenmedi</x:String>
    <x:String x:Key="PdfViewer_EmptyDesc">Belgenin meta verilerini, sayfalarını ve özelliklerini analiz etmek ve varsayılan sistem PDF okuyucunuzda hızlıca başlatmak için bir PDF dosyası seçin.</x:String>
    <x:String x:Key="PdfViewer_OpenExternal">Sistemde Aç</x:String>
    <x:String x:Key="PdfViewer_NativeNote">En iyi çapraz platform okuma, yazdırma ve form doldurma deneyimi için Docentra, macOS varsayılan PDF görüntüleyicinize sorunsuz bir şekilde köprü kurar.</x:String>

    <!-- Navigasyon eklentileri -->
    <x:String x:Key="Nav_Compress">PDF Sıkıştır</x:String>
    <x:String x:Key="Nav_Metadata">Meta Veri Düzenle</x:String>
    <x:String x:Key="Nav_Premium">Premium'a Geç</x:String>

    <!-- Compress -->
    <x:String x:Key="Compress_Title">PDF Sıkıştır</x:String>
    <x:String x:Key="Compress_Desc">Optimum kaliteyi korurken PDF belgelerinizin dosya boyutunu küçültün.</x:String>
    <x:String x:Key="Compress_SelectFile">Sıkıştırmak İçin PDF Dosyası Seçin</x:String>
    <x:String x:Key="Compress_LevelTitle">Sıkıştırma Seviyesi</x:String>
    <x:String x:Key="Compress_LevelLow">Düşük Sıkıştırma</x:String>
    <x:String x:Key="Compress_LevelLowDesc">Hafif boyut küçültme, en yüksek görsel kalitesi.</x:String>
    <x:String x:Key="Compress_LevelMed">Orta Sıkıştırma</x:String>
    <x:String x:Key="Compress_LevelMedDesc">Önerilen. Büyük oranda boyut küçültme, iyi kalite.</x:String>
    <x:String x:Key="Compress_LevelHigh">Yüksek Sıkıştırma</x:String>
    <x:String x:Key="Compress_LevelHighDesc">Maksimum boyut küçültme, daha düşük görsel kalitesi.</x:String>
    <x:String x:Key="Compress_ProcessBtn">SIKIŞTIR VE KAYDET</x:String>

    <!-- Metadata -->
    <x:String x:Key="Metadata_Title">PDF Meta Verilerini Düzenle</x:String>
    <x:String x:Key="Metadata_Desc">PDF belgenize gömülü yazar, başlık, anahtar kelimeler ve diğer etiketleri güncelleyin.</x:String>
    <x:String x:Key="Metadata_TitleField">Belge Başlığı</x:String>
    <x:String x:Key="Metadata_Author">Yazar</x:String>
    <x:String x:Key="Metadata_Subject">Konu</x:String>
    <x:String x:Key="Metadata_Keywords">Anahtar Kelimeler</x:String>
    <x:String x:Key="Metadata_Creator">Oluşturucu Uygulama</x:String>
    <x:String x:Key="Metadata_Producer">PDF Üreticisi</x:String>
    <x:String x:Key="Metadata_CreationDate">Oluşturulma Tarihi</x:String>
    <x:String x:Key="Metadata_ModificationDate">Değiştirilme Tarihi</x:String>
    <x:String x:Key="Metadata_SaveBtn">META VERİLERİ KAYDET</x:String>

    <!-- Premium -->
    <x:String x:Key="Prem_Title">Premium'a Geç</x:String>
    <x:String x:Key="Prem_Subtitle">Tüm profesyonel özelliklerin kilidini açın ve tüm platform sınırlamalarını kaldırın.</x:String>
    <x:String x:Key="Prem_Licensed">Lisans Aktif Edildi</x:String>
    <x:String x:Key="Prem_ThankYou">Docentra'yı desteklediğiniz için teşekkür ederiz!</x:String>
    <x:String x:Key="Prem_HowToActivate_Title">Nasıl aktif edilir?</x:String>
    <x:String x:Key="Prem_HowToActivate_Sub">Aşağıdaki Cihaz Donanım Kimliğinizi (HWID) kopyalayın ve aktivasyon anahtarınızı almak için Etsy'deki destek kutumuza gönderin.</x:String>
    <x:String x:Key="Prem_HwidLabel">Cihaz Donanım Kimliği (HWID)</x:String>
    <x:String x:Key="Prem_HwidDesc">Bu benzersiz donanım imzası, lisansınızın bu iş istasyonuna güvenli bir şekilde bağlı kalmasını sağlar.</x:String>
    <x:String x:Key="Prem_KeyLabel">Lisans Anahtarını Girin</x:String>
    <x:String x:Key="Prem_BtnActivate">ŞİMDİ AKTİF ET</x:String>
    <x:String x:Key="Prem_WhyGoPremium">Neden Premium'a yükseltmeli?</x:String>
    <x:String x:Key="Prem_Feat1_Title">Eksiksiz PDF Araç Kutusu</x:String>
    <x:String x:Key="Prem_Feat1_Desc">Bölme, birleştirme, kırpma, filigran, sayfa numaraları ve sıkıştırma özelliklerine sınırsızca erişin.</x:String>
    <x:String x:Key="Prem_Feat2_Title">Hızlı Çoklu İş Parçacığı Motoru</x:String>
    <x:String x:Key="Prem_Feat2_Desc">Tam işlemci ölçeklemesini kullanarak büyük belge işlemlerini 10 kata kadar daha hızlı gerçekleştirin.</x:String>
    <x:String x:Key="Prem_Feat3_Title">Profesyonel Ömür Boyu Destek</x:String>
    <x:String x:Key="Prem_Feat3_Desc">Tüm küçük ve büyük güncellemeleri ücretsiz olarak standart öncelikli bilet hizmetiyle alın.</x:String>
    <x:String x:Key="Dash_CompressSub">Optimum sıkıştırma oranları ile PDF belge boyutunu küçültün.</x:String>
    <x:String x:Key="Dash_MetadataSub">Gömülü yazar, başlık ve anahtar kelime etiketlerini güncelleyin.</x:String>

    <!-- OCR -->
    <x:String x:Key="Ocr_Title">Metin Tanıma (OCR)</x:String>
    <x:String x:Key="Ocr_Desc">Yerel donanım motorlarını kullanarak görsel ve PDF dosyalarından metinleri otomatik olarak çıkarın.</x:String>
    <x:String x:Key="Ocr_SelectFile">Görsel veya PDF Dosyası Seçin</x:String>
    <x:String x:Key="Ocr_Language">Tanıma Dili</x:String>
    <x:String x:Key="Ocr_RunBtn">METNİ ÇIKAR / TANI</x:String>
    <x:String x:Key="Ocr_ResultPlaceholder">Tanınan metinler burada görüntülenecektir...</x:String>
    <x:String x:Key="Ocr_Success">Metin tanıma işlemi başarıyla tamamlandı!</x:String>
    <x:String x:Key="Ocr_SaveSuccess">OCR sonucu başarıyla kaydedildi!</x:String>
    <x:String x:Key="Ocr_NoFile">Lütfen önce bir görsel veya PDF dosyası seçin.</x:String>
    <x:String x:Key="Ocr_SelectFilter">PDF ve Görseller (*.pdf;*.png;*.jpg;*.jpeg)|*.pdf;*.png;*.jpg;*.jpeg</x:String>
    <x:String x:Key="Ocr_BtnCopy">Metni Kopyala</x:String>
    <x:String x:Key="Ocr_BtnSave">TXT Olarak Kaydet</x:String>
    <x:String x:Key="Dash_OcrSub">Yerel donanım ivmesini kullanarak görsellerden ve belgelerden metinleri algılayın ve çıkarın.</x:String>
</ResourceDictionary>
