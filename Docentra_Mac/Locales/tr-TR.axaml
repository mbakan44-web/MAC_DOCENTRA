    <x:String x:Key="Split_Success">Dosya başarıyla ayrıldı!</x:String>
    <x:String x:Key="Split_SelectError">Lütfen bir PDF dosyası seçin.</x:String>

    <!-- Watermark -->
    <x:String x:Key="Watermark_Title">Filigran Ekle</x:String>
    <x:String x:Key="Watermark_Desc">Belgelerinizi metin veya resim filigranları ile koruyun.</x:String>
