    <x:String x:Key="Watermark_ImgDesc">Logonuzu veya resminizi belgenin herhangi bir yerine yerleştirin.</x:String>

    <!-- Protect -->
    <x:String x:Key="Sec_Title_Password">Şifrele &amp; Koru</x:String>
    <x:String x:Key="Sec_Desc_Password">Dosyalarınızı yetkisiz erişime karşı şifreleyerek koruyun.</x:String>
    <x:String x:Key="Sec_Password">Şifre Belirle</x:String>
    <x:String x:Key="Sec_PasswordDesc">Dosyayı açmak için gereken şifreyi girin.</x:String>
    <x:String x:Key="Sec_PassStep1">PDF Dosyası Seçin</x:String>
    <x:String x:Key="Protect_Title">Şifrele &amp; Koru</x:String>
    <x:String x:Key="Protect_Start">ŞİFRELE VE KAYDET</x:String>
