    <x:String x:Key="Protect_SelectError">Lütfen bir dosya seçin ve şifre girin.</x:String>
    <x:String x:Key="Protect_PassLabel">Şifre Belirleyin:</x:String>
    <x:String x:Key="Protect_Placeholder">Dosyayı korumak için bir şifre girin...</x:String>
    
    <!-- Unlock -->
