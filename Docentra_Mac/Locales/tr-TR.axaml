<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:String x:Key="AppTitle">DOCENTRA PDF &amp; BELGE EDİTÖRÜ</x:String>
    <x:String x:Key="Nav_Dashboard">Panel</x:String>
    <x:String x:Key="Nav_Merge">PDF Birleştir</x:String>
    <x:String x:Key="Nav_Split">PDF Ayır</x:String>
    <x:String x:Key="Nav_Settings">Ayarlar</x:String>
    <x:String x:Key="Prem_Title">Premium</x:String>
    <x:String x:Key="Prem_TrialBanner">DENEME MODU</x:String>
    <x:String x:Key="Prem_DaysRemaining">7 gün kaldı</x:String>
    
    <!-- Dashboard -->
    <x:String x:Key="Dash_Welcome">Hoş Geldiniz</x:String>
    <x:String x:Key="Dash_DragDrop">Dosyaları buraya sürükleyin veya ekleyin</x:String>
    <x:String x:Key="Dash_Desc">Docentra PDF Suite ile belgelerinizi kolayca yönetin.</x:String>
    <x:String x:Key="Dash_MergeSub">Birden fazla PDF'i tek bir dosyada toplayın.</x:String>
    <x:String x:Key="Dash_SplitSub">Belgenizi sayfalara bölün veya ayıklayın.</x:String>
    <x:String x:Key="Dash_ImgSub">Resimlerinizi PDF formatına dönüştürün.</x:String>
    <x:String x:Key="Dash_ImgTitle">Resimden PDF'e</x:String>
    <x:String x:Key="Dash_OfficeSub">Office belgelerini PDF'e dönüştürün.</x:String>
    <x:String x:Key="Dash_OfficeTitle">Office'ten PDF'e</x:String>
    <x:String x:Key="Dash_WordSub">PDF dosyalarını Word'e dönüştürün.</x:String>
    <x:String x:Key="Dash_WordTitle">PDF'ten Word'e</x:String>
    <x:String x:Key="Dash_SignSub">Belgelerinize dijital imza veya logo ekleyin.</x:String>
    <x:String x:Key="Dash_ProtectSub">Dosyalarınızı şifre ile koruma altına alın.</x:String>
    <x:String x:Key="Dash_CropSub">Sayfa kenarlarını kesin ve düzenleyin.</x:String>

    <!-- Merge -->
    <x:String x:Key="Merge_Title">PDF Dosyalarını Birleştir</x:String>
    <x:String x:Key="Merge_AddFiles">Dosya Ekle</x:String>
    <x:String x:Key="Merge_Clear">Listeyi Temizle</x:String>
    <x:String x:Key="Merge_Desc">Birden fazla PDF dosyasını istediğiniz sırada tek bir belgede birleştirin.</x:String>
    <x:String x:Key="Merge_Start">BİRLEŞTİR VE KAYDET</x:String>
    <x:String x:Key="Merge_Success">Dosyalar başarıyla birleştirildi!</x:String>
    <x:String x:Key="Merge_SelectError">Lütfen en az iki dosya seçin.</x:String>
    
    <!-- Split -->
    <x:String x:Key="Split_Title">PDF Dosyasını Ayır</x:String>
    <x:String x:Key="Split_Desc">Belgenizi sayfalara bölün veya belirli aralıkları ayıklayın.</x:String>
    <x:String x:Key="Split_Options">Ayırma Seçenekleri</x:String>
    <x:String x:Key="Split_OptSeparate">Tüm Sayfaları Ayır</x:String>
    <x:String x:Key="Split_OptDesc">Her sayfayı ayrı bir PDF dosyası olarak kaydeder.</x:String>
    <x:String x:Key="Split_OptRange">Belirli Sayfaları Çıkar</x:String>
    <x:String x:Key="Split_RangeHint">Örn: 1, 3, 5-10</x:String>
