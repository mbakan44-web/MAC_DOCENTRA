<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="Docentra_Mac.Views.Pages.MetadataEditorPage">

    <Grid RowDefinitions="Auto, *, Auto" Margin="20">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{DynamicResource Metadata_Title}" FontSize="28" FontWeight="Black" Foreground="{DynamicResource PremiumAccentBrush}"/>
            <TextBlock Text="{DynamicResource Metadata_Desc}" FontSize="14" Opacity="0.6"/>
        </StackPanel>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="25" MaxWidth="800" HorizontalAlignment="Left">
                
                <!-- File Selection Area -->
                <Button x:Name="BtnSelectFile" HorizontalAlignment="Stretch" Background="{DynamicResource ToolCardBackground}" 
                        BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="15" Padding="25" Click="BtnSelectFile_Click">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <PathIcon Grid.Column="0" Data="{StaticResource DocumentRegular}" Width="40" Height="40" Foreground="{DynamicResource PremiumAccentBrush}" Margin="0,0,20,0"/>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Gen_SelectFile}" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtSelectedFile" Text="{DynamicResource PdfViewer_EmptyDesc}" FontSize="13" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        
                        <PathIcon Grid.Column="2" Data="{StaticResource ChevronRightRegular}" Width="16" Height="16" Opacity="0.5" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- Settings/Form Panel -->
                <StackPanel x:Name="SettingsPanel" Spacing="15" IsEnabled="False">
                    <!-- Title -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="{DynamicResource Metadata_TitleField}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBox x:Name="TxtTitle" Watermark="Document Title" CornerRadius="8" Background="#15FFFFFF" BorderThickness="1" BorderBrush="#25FFFFFF"/>
                    </StackPanel>
                    
                    <!-- Author -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="{DynamicResource Metadata_Author}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBox x:Name="TxtAuthor" Watermark="Document Author" CornerRadius="8" Background="#15FFFFFF" BorderThickness="1" BorderBrush="#25FFFFFF"/>
                    </StackPanel>
                    
                    <!-- Subject -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="{DynamicResource Metadata_Subject}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBox x:Name="TxtSubject" Watermark="Document Subject" CornerRadius="8" Background="#15FFFFFF" BorderThickness="1" BorderBrush="#25FFFFFF"/>
                    </StackPanel>
                    
                    <!-- Keywords -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="{DynamicResource Metadata_Keywords}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBox x:Name="TxtKeywords" Watermark="Keywords (comma separated)" CornerRadius="8" Background="#15FFFFFF" BorderThickness="1" BorderBrush="#25FFFFFF"/>
                    </StackPanel>
                    
                    <!-- Creator -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="{DynamicResource Metadata_Creator}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBox x:Name="TxtCreator" Watermark="Creator Application" CornerRadius="8" Background="#15FFFFFF" BorderThickness="1" BorderBrush="#25FFFFFF"/>
                    </StackPanel>
                    
                    <!-- Producer -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="{DynamicResource Metadata_Producer}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBox x:Name="TxtProducer" Watermark="PDF Producer" IsReadOnly="True" CornerRadius="8" Background="#10FFFFFF" BorderThickness="1" BorderBrush="#20FFFFFF" Opacity="0.6"/>
                    </StackPanel>

                    <!-- Creation / Modification Dates -->
                    <Grid ColumnDefinitions="*, 20, *">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{DynamicResource Metadata_CreationDate}" FontWeight="SemiBold" FontSize="12" Opacity="0.5"/>
                            <TextBlock x:Name="TxtCreationDate" Text="-" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="{DynamicResource Metadata_ModificationDate}" FontWeight="SemiBold" FontSize="12" Opacity="0.5"/>
                            <TextBlock x:Name="TxtModificationDate" Text="-" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,20,0,0">
            <ProgressBar x:Name="LoadingRing" IsIndeterminate="True" VerticalAlignment="Center" IsVisible="False" Width="100" HorizontalAlignment="Left"/>
            
            <Button Grid.Column="1" x:Name="BtnSave" Click="BtnSave_Click" IsEnabled="False"
                    Background="{DynamicResource PremiumAccentBrush}" Foreground="Black" FontWeight="Bold" Padding="35,15" CornerRadius="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="{StaticResource SaveRegular}" Width="16" Height="16" Foreground="Black"/>
                    <TextBlock Text="{DynamicResource Metadata_SaveBtn}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>

    <UserControl.Resources>
        <StreamGeometry x:Key="DocumentRegular">M14 2H6C4.89543 2 4 2.89543 4 4V20C4 21.1046 4.89543 22 6 22H18C19.1046 22 20 21.1046 20 20V8L14 2ZM13 9V3.5L18.5 9H13Z</StreamGeometry>
        <StreamGeometry x:Key="ChevronRightRegular">M6.29289 4.29289C5.90237 4.68342 5.90237 5.31658 6.29289 5.70711L12.5858 12L6.29289 18.2929C5.90237 18.6834 5.90237 19.3166 6.29289 19.7071C6.68342 20.0976 7.31658 20.0976 7.70711 19.7071L14.7071 12.7071C15.0976 12.3166 15.0976 11.6834 14.7071 11.2929L7.70711 4.29289C7.31658 3.90237 6.68342 3.90237 6.29289 4.29289Z</StreamGeometry>
        <StreamGeometry x:Key="SaveRegular">M19 12V19H5V5H12V3H5C3.89 3 3 3.9 3 5V19C3 20.1 3.89 21 5 21H19C20.1 21 21 20.1 21 19V12H19ZM12.5 10.12L17.12 5.5L18.53 6.91L13.91 11.53L12.5 10.12ZM19 3H16V5H19V8H21V5C21 3.9 20.1 3 19 3Z</StreamGeometry>
    </UserControl.Resources>
</UserControl>
