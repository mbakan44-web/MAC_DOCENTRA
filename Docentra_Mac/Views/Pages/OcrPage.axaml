<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="using:Docentra_Mac.Services"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="Docentra_Mac.Views.Pages.OcrPage">

    <Grid RowDefinitions="Auto, *" Margin="20">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Ocr_Title}" FontSize="28" FontWeight="Black" Foreground="{DynamicResource PremiumAccentBrush}"/>
            <TextBlock Text="{DynamicResource Ocr_Desc}" FontSize="14" Opacity="0.6"/>
        </StackPanel>

        <!-- Main Workspace -->
        <Grid Grid.Row="1" ColumnDefinitions="360, *" Margin="0,15,0,0">
            
            <!-- Left Panel: Settings and Actions -->
            <StackPanel Grid.Column="0" Spacing="20" VerticalAlignment="Top" Margin="0,0,10,0">
                
                <!-- File Browser Card -->
                <Border Background="{DynamicResource ToolCardBackground}" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="16" Padding="15">
                    <StackPanel Spacing="12">
                        <Button x:Name="BtnBrowse" HorizontalAlignment="Stretch" Padding="15" Background="#10FFFFFF" 
                                BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="12" Click="BtnBrowse_Click">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <PathIcon Grid.Column="0" Data="{StaticResource DocumentRegular}" Width="32" Height="32" Foreground="#8B5CF6" Margin="0,0,15,0"/>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Ocr_SelectFile}" FontSize="14" FontWeight="Bold" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="TxtSourceFile" Text="{DynamicResource Common_PathPlaceholder}" FontSize="11" Opacity="0.5" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                
                                <PathIcon Grid.Column="2" Data="{StaticResource ChevronRightRegular}" Width="14" Height="14" Opacity="0.5" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        
                        <!-- Mini Preview Icon -->
                        <Border x:Name="PreviewBox" Background="#08FFFFFF" Height="120" CornerRadius="10" BorderThickness="1" BorderBrush="#10FFFFFF" IsVisible="False" Padding="10">
                            <Grid ColumnDefinitions="Auto, *">
                                <PathIcon x:Name="PreviewIcon" Data="{StaticResource DocumentRegular}" Width="40" Height="40" Foreground="#10B981" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtFileName" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TxtFileType" FontSize="10" Opacity="0.5"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Language Selector Card -->
                <Border Background="{DynamicResource ToolCardBackground}" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="16" Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{DynamicResource Ocr_Language}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextForeground}"/>
                        
                        <ComboBox x:Name="CboLanguages" HorizontalAlignment="Stretch" Padding="10,8" CornerRadius="10" Background="#10FFFFFF" BorderBrush="#15FFFFFF">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="services:OcrLanguage">
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Trigger Action Button -->
                <Button x:Name="BtnRunOcr" Click="BtnRunOcr_Click" IsEnabled="False"
                        HorizontalAlignment="Stretch" Padding="20,15"
                        Background="{DynamicResource PremiumAccentBrush}" Foreground="Black" FontWeight="Bold" CornerRadius="12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                        <PathIcon Data="{StaticResource OcrRegular}" Width="18" Height="18" Foreground="Black"/>
                        <TextBlock Text="{DynamicResource Ocr_RunBtn}" VerticalAlignment="Center" FontSize="14" LetterSpacing="0.5"/>
                    </StackPanel>
                </Button>

                <!-- Loading Indicators -->
                <StackPanel x:Name="PanelLoading" IsVisible="False" Spacing="10" HorizontalAlignment="Stretch">
                    <ProgressBar IsIndeterminate="True" Height="4" CornerRadius="2" Foreground="{DynamicResource PremiumAccentBrush}"/>
                    <TextBlock Text="{DynamicResource Gen_Processing}" FontSize="12" HorizontalAlignment="Center" Opacity="0.6"/>
                </StackPanel>
            </StackPanel>

            <!-- Right Panel: Results Viewer -->
            <Border Grid.Column="1" Background="{DynamicResource ToolCardBackground}" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="20" Padding="20" Margin="15,0,0,0">
                <Grid RowDefinitions="*, Auto">
                    
                    <!-- Result Display -->
                    <TextBox Grid.Row="0" x:Name="TxtResult" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             Watermark="{DynamicResource Ocr_ResultPlaceholder}" FontSize="14"
                             Background="Transparent" BorderThickness="0" Padding="5" Foreground="{DynamicResource TextForeground}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                    <!-- Footer Actions -->
                    <Border Grid.Row="1" BorderBrush="#10FFFFFF" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,15,0,0">
                        <Grid ColumnDefinitions="Auto, Auto, *">
                            <Button Grid.Column="0" x:Name="BtnCopy" Click="BtnCopy_Click" IsEnabled="False"
                                    Background="#15FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" Padding="15,10" CornerRadius="10" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource CopyRegular}" Width="16" Height="16" Opacity="0.8"/>
                                    <TextBlock Text="{DynamicResource Ocr_BtnCopy}" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1" x:Name="BtnSave" Click="BtnSave_Click" IsEnabled="False"
                                    Background="#15FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" Padding="15,10" CornerRadius="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource SaveRegular}" Width="16" Height="16" Opacity="0.8"/>
                                    <TextBlock Text="{DynamicResource Ocr_BtnSave}" FontSize="13"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>

    <UserControl.Resources>
        <StreamGeometry x:Key="DocumentRegular">M14 2H6C4.89543 2 4 2.89543 4 4V20C4 21.1046 4.89543 22 6 22H18C19.1046 22 20 21.1046 20 20V8L14 2ZM13 9V3.5L18.5 9H13Z</StreamGeometry>
        <StreamGeometry x:Key="ChevronRightRegular">M6.29289 4.29289C5.90237 4.68342 5.90237 5.31658 6.29289 5.70711L12.5858 12L6.29289 18.2929C5.90237 18.6834 5.90237 19.3166 6.29289 19.7071C6.68342 20.0976 7.31658 20.0976 7.70711 19.7071L14.7071 12.7071C15.0976 12.3166 15.0976 11.6834 14.7071 11.2929L7.70711 4.29289C7.31658 3.90237 6.68342 3.90237 6.29289 4.29289Z</StreamGeometry>
        <StreamGeometry x:Key="CopyRegular">M19 21H8C6.9 21 6 20.1 6 19V7H5C3.9 7 3 7.9 3 9V20C3 21.1 3.9 22 5 22H16C17.1 22 18 21.1 18 20 M19 2H10C8.9 2 8 2.9 8 4V15C8 16.1 8.9 17 10 17H19C20.1 17 21 16.1 21 15V4C21 2.9 20.1 2 19 2ZM19 15H10V4H19V15Z</StreamGeometry>
        <StreamGeometry x:Key="SaveRegular">M19 21H5C3.9 21 3 20.1 3 19V5C3 3.9 3.9 3 5 3H14L21 10V19C21 20.1 20.1 21 19 21Z M14 3V10H21 M7 21V14H15V21</StreamGeometry>
        <StreamGeometry x:Key="ImageIconRegular">M21 19V5C21 3.9 20.1 3 19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19ZM8.5 9.5C8.5 8.67 9.17 8 10 8C10.83 8 11.5 8.67 11.5 9.5C11.5 10.33 10.83 11 10 11C9.17 11 8.5 10.33 8.5 9.5ZM5 17L9 12L12 16L16 11L20 17H5Z</StreamGeometry>
    </UserControl.Resources>
</UserControl>
