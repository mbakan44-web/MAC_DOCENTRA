<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Docentra_Mac.Views.Pages.DeletePagesPage">
    
    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="20,20,20,30">
            <TextBlock Text="{DynamicResource DeletePages_Title}" FontSize="28" FontWeight="Black" Foreground="#E81123"/>
            <TextBlock Text="{DynamicResource DeletePages_Desc}" FontSize="14" Opacity="0.6"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="25" Margin="20,0,20,20">
                <!-- Selection Card -->
                <Border Background="{DynamicResource ToolCardBackground}" CornerRadius="15" BorderBrush="#20FFFFFF" BorderThickness="1" MaxWidth="700" HorizontalAlignment="Left">
                    <Button HorizontalAlignment="Stretch" Padding="30" Background="Transparent" Click="SelectFile_Click">
                        <Grid ColumnDefinitions="Auto, *">
                            <PathIcon Data="{StaticResource DocumentSearchRegular}" Width="48" Height="48" Foreground="#E81123" Margin="0,0,25,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Sec_SelectPdf}" FontSize="20" FontWeight="Bold"/>
                                <TextBlock x:Name="SelectedFileText" Text="..." FontSize="14" Opacity="0.5" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Border>

                <!-- Options Card -->
                <Border Background="{DynamicResource ToolCardBackground}" CornerRadius="15" Padding="25" BorderBrush="#20FFFFFF" BorderThickness="1" MaxWidth="700" HorizontalAlignment="Left">
                    <StackPanel Spacing="20">
                        <TextBlock Text="{DynamicResource DeletePages_Options}" FontSize="18" FontWeight="Bold"/>
                        
                        <StackPanel Spacing="10">
                            <TextBlock Text="{DynamicResource DeletePages_InputLabel}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBox x:Name="TxtRange" Watermark="1, 3, 5:8" Background="#15000000" CornerRadius="8" Padding="10"/>
                            <TextBlock Text="{DynamicResource DeletePages_InputHint}" FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Content="{DynamicResource DeletePages_Btn}" Click="Delete_Click" 
                                Background="#E81123" Foreground="White" FontWeight="Bold"
                                HorizontalAlignment="Right" Padding="40,12" CornerRadius="10"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText" HorizontalAlignment="Center" FontSize="12" Opacity="0.8"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <UserControl.Resources>
        <StreamGeometry x:Key="DocumentSearchRegular">M14 2H6C4.89543 2 4 2.89543 4 4V20C4 21.1046 4.89543 22 6 22H18C19.1046 22 20 21.1046 20 20V8L14 2ZM13 9V3.5L18.5 9H13ZM10.5 13C11.3284 13 12 13.6716 12 14.5C12 14.8219 11.8988 15.1197 11.7262 15.3626L13.8536 17.4899L13.1464 18.197L11.0191 16.0697C10.8647 16.3409 10.5 16.5 10.5 16.5C9.67157 16.5 9 15.8284 9 15C9 14.1716 9.67157 13.5 10.5 13.5V13Z</StreamGeometry>
    </UserControl.Resources>
</UserControl>
