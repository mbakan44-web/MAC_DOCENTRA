<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Docentra_Mac.Views.Pages.SignPage">
    
    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="20,20,20,30">
            <TextBlock Text="{DynamicResource Sign_Title}" FontSize="28" FontWeight="Black" Foreground="{DynamicResource PremiumAccentBrush}"/>
            <TextBlock Text="{DynamicResource Dash_SignSub}" FontSize="14" Opacity="0.6"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="25" Margin="20,0,20,20">
                <Border Background="{DynamicResource ToolCardBackground}" CornerRadius="15" Padding="25" BorderBrush="#20FFFFFF" BorderThickness="1" MaxWidth="600" HorizontalAlignment="Left">
                    <StackPanel Spacing="20">
                        <TextBlock Text="{DynamicResource Sign_Method}" FontSize="18" FontWeight="Bold"/>
                        
                        <Button HorizontalAlignment="Stretch" Padding="15" Background="#10FFFFFF" CornerRadius="10" Click="SelectFile_Click">
                            <Grid ColumnDefinitions="Auto, *">
                                <PathIcon Data="{StaticResource DocumentSearchRegular}" Width="20" Height="20" Foreground="{DynamicResource PremiumAccentBrush}" Margin="0,0,15,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource Sec_SelectPdf}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SelectedFileText" Text="..." FontSize="11" Opacity="0.5" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button HorizontalAlignment="Stretch" Padding="15" Background="#10FFFFFF" CornerRadius="10" Click="SelectImage_Click">
                            <Grid ColumnDefinitions="Auto, *">
                                <PathIcon Data="{StaticResource ImageRegular}" Width="20" Height="20" Foreground="{DynamicResource PremiumAccentBrush}" Margin="0,0,15,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource Sign_SelectImage}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SelectedImageText" Text="..." FontSize="11" Opacity="0.5" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Border Background="#05FFFFFF" CornerRadius="10" Padding="15" BorderBrush="#10FFFFFF" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Interactive Placement" FontSize="13" Opacity="0.7" TextWrapping="Wrap"/>
                                <Button Content="Open Visual Position Editor" Click="OpenEditor_Click" 
                                        Background="#33FFFFFF" HorizontalAlignment="Stretch" Padding="10" CornerRadius="8"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="StatusText" HorizontalAlignment="Center" FontSize="12" Opacity="0.8"/>

                        <Button Content="{DynamicResource Sign_Start}" Click="Sign_Click" 
                                Background="{DynamicResource PremiumAccentBrush}" Foreground="Black" FontWeight="Bold"
                                HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Padding="0,15" CornerRadius="10"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <UserControl.Resources>
        <StreamGeometry x:Key="DocumentSearchRegular">M14 2H6C4.89543 2 4 2.89543 4 4V20C4 21.1046 4.89543 22 6 22H18C19.1046 22 20 21.1046 20 20V8L14 2ZM13 9V3.5L18.5 9H13ZM10.5 13C11.3284 13 12 13.6716 12 14.5C12 14.8219 11.8988 15.1197 11.7262 15.3626L13.8536 17.4899L13.1464 18.197L11.0191 16.0697C10.8647 16.3409 10.5 16.5 10.5 16.5C9.67157 16.5 9 15.8284 9 15C9 14.1716 9.67157 13.5 10.5 13.5V13Z</StreamGeometry>
        <StreamGeometry x:Key="ImageRegular">M19 5V19H5V5H19ZM19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3ZM14.14 11.86L11.14 15.73L9 13.14L6 17H18L14.14 11.86Z</StreamGeometry>
    </UserControl.Resources>
</UserControl>
