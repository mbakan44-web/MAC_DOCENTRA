<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Docentra_Mac.Views.Pages.ConvertPage">
    
    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="20,20,20,30">
            <TextBlock Text="{DynamicResource Conv_Title}" FontSize="28" FontWeight="Black" Foreground="{DynamicResource PremiumAccentBrush}"/>
            <TextBlock Text="{DynamicResource Conv_Desc}" FontSize="14" Opacity="0.6"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                <!-- 1. Image to PDF -->
                <Button Classes="tool" Click="ImageToPdf_Click" Margin="10" Width="280" Height="220">
                    <StackPanel Spacing="15" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource ImageRegular}" Width="48" Height="48" Foreground="#107C10"/>
                        <TextBlock Text="{DynamicResource Dash_ImgTitle}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Dash_ImgSub}" FontSize="12" Opacity="0.6" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>

                <!-- 2. PDF to Image -->
                <Button Classes="tool" Click="PdfToImage_Click" Margin="10" Width="280" Height="220">
                    <StackPanel Spacing="15" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource PictureRegular}" Width="48" Height="48" Foreground="#D83B01"/>
                        <TextBlock Text="{DynamicResource Conv_PdfToImg}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Conv_PdfToImgDesc}" FontSize="12" Opacity="0.6" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>

                <!-- 3. Office to PDF -->
                <Button Classes="tool" Click="OfficeToPdf_Click" Margin="10" Width="280" Height="220">
                    <StackPanel Spacing="15" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource OfficeRegular}" Width="48" Height="48" Foreground="#FF8C00"/>
                        <TextBlock Text="{DynamicResource Dash_OfficeTitle}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Dash_OfficeSub}" FontSize="12" Opacity="0.6" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>

                <!-- 4. PDF to Word -->
                <Button Classes="tool" Click="PdfToWord_Click" Margin="10" Width="280" Height="220">
                    <StackPanel Spacing="15" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource WordRegular}" Width="48" Height="48" Foreground="#2B579A"/>
                        <TextBlock Text="{DynamicResource Dash_WordTitle}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Dash_WordSub}" FontSize="12" Opacity="0.6" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </ScrollViewer>
    </Grid>

    <UserControl.Resources>
        <StreamGeometry x:Key="ImageRegular">M19 5V19H5V5H19ZM19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3ZM14.14 11.86L11.14 15.73L9 13.14L6 17H18L14.14 11.86Z</StreamGeometry>
        <StreamGeometry x:Key="PictureRegular">M21 19V5C21 3.9 20.1 3 19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19ZM8.5 13.5L11 16.51L14.5 12L19 18H5L8.5 13.5Z</StreamGeometry>
        <StreamGeometry x:Key="OfficeRegular">M14 2H6C4.89543 2 4 2.89543 4 4V20C4 21.1046 4.89543 22 6 22H18C19.1046 22 20 21.1046 20 20V8L14 2ZM13 9V3.5L18.5 9H13Z</StreamGeometry>
        <StreamGeometry x:Key="WordRegular">M14 2H6C4.89543 2 4 2.89543 4 4V20C4 21.1046 4.89543 22 6 22H18C19.1046 22 20 21.1046 20 20V8L14 2ZM13 9V3.5L18.5 9H13ZM9 12V16H11V12H9ZM13 12V16H15V12H13Z</StreamGeometry>
    </UserControl.Resources>
</UserControl>
