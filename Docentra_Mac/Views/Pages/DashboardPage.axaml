<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             x:Class="Docentra_Mac.Views.Pages.DashboardPage">
    <ScrollViewer>
        <StackPanel Margin="30">
            <TextBlock Text="{DynamicResource Dash_Welcome}" FontSize="32" FontWeight="Black" Margin="0,0,0,10"/>
            <TextBlock Text="{DynamicResource Dash_Desc}" FontSize="14" Opacity="0.6" Margin="0,0,0,40"/>

            <WrapPanel Margin="-10">
                <!-- Merge Card -->
                <Button Classes="ToolCard" Click="ToolCard_Click" Tag="Merge" Margin="10">
                    <StackPanel Spacing="15">
                        <PathIcon Data="{StaticResource MergeRegular}" Width="36" Height="36" Foreground="{DynamicResource PremiumAccentBrush}"/>
                        <TextBlock Text="{DynamicResource Nav_Merge}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Dash_MergeSub}" FontSize="11" Opacity="0.5" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Split Card -->
                <Button Classes="ToolCard" Click="ToolCard_Click" Tag="Split" Margin="10">
                    <StackPanel Spacing="15">
                        <PathIcon Data="{StaticResource SplitRegular}" Width="36" Height="36" Foreground="#F43F5E"/>
                        <TextBlock Text="{DynamicResource Nav_Split}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Dash_SplitSub}" FontSize="11" Opacity="0.5" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Watermark Card -->
                <Button Classes="ToolCard" Click="ToolCard_Click" Tag="Watermark" Margin="10">
                    <StackPanel Spacing="15">
                        <PathIcon Data="{StaticResource WatermarkRegular}" Width="36" Height="36" Foreground="#8B5CF6"/>
                        <TextBlock Text="{DynamicResource Watermark_Title}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Dash_SignSub}" FontSize="11" Opacity="0.5" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Protect Card -->
                <Button Classes="ToolCard" Click="ToolCard_Click" Tag="Protect" Margin="10">
                    <StackPanel Spacing="15">
                        <PathIcon Data="{StaticResource LockRegular}" Width="36" Height="36" Foreground="#EC4899"/>
                        <TextBlock Text="{DynamicResource Protect_Title}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Dash_ProtectSub}" FontSize="11" Opacity="0.5" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Delete Pages Card -->
                <Button Classes="ToolCard" Click="ToolCard_Click" Tag="DeletePages" Margin="10">
                    <StackPanel Spacing="15">
                        <PathIcon Data="{StaticResource DeleteRegular}" Width="36" Height="36" Foreground="#EF4444"/>
                        <TextBlock Text="{DynamicResource Delete_Title}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Delete_Desc}" FontSize="11" Opacity="0.5" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Page Numbers Card -->
                <Button Classes="ToolCard" Click="ToolCard_Click" Tag="PageNumbers" Margin="10">
                    <StackPanel Spacing="15">
                        <PathIcon Data="{StaticResource PageNumRegular}" Width="36" Height="36" Foreground="#10B981"/>
                        <TextBlock Text="{DynamicResource PageNum_Title}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource PageNum_Desc}" FontSize="11" Opacity="0.5" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Crop Card -->
                <Button Classes="ToolCard" Click="ToolCard_Click" Tag="Crop" Margin="10">
                    <StackPanel Spacing="15">
                        <PathIcon Data="{StaticResource CropRegular}" Width="36" Height="36" Foreground="#06B6D4"/>
                        <TextBlock Text="{DynamicResource Crop_Title}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Crop_Desc}" FontSize="11" Opacity="0.5" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Sign Card -->
                <Button Classes="ToolCard" Click="ToolCard_Click" Tag="Sign" Margin="10">
                    <StackPanel Spacing="15">
                        <PathIcon Data="{StaticResource SignRegular}" Width="36" Height="36" Foreground="#F59E0B"/>
                        <TextBlock Text="{DynamicResource Sign_Title}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Dash_SignSub}" FontSize="11" Opacity="0.5" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Convert Card -->
                <Button Classes="ToolCard" Click="ToolCard_Click" Tag="Convert" Margin="10">
                    <StackPanel Spacing="15">
                        <PathIcon Data="{StaticResource ConvertRegular}" Width="36" Height="36" Foreground="#6366F1"/>
                        <TextBlock Text="{DynamicResource Conv_Title}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Conv_Desc}" FontSize="11" Opacity="0.5" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- PDF Viewer Card -->
                <Button Classes="ToolCard" Click="ToolCard_Click" Tag="PdfViewer" Margin="10">
                    <StackPanel Spacing="15">
                        <PathIcon Data="{StaticResource PdfViewerRegular}" Width="36" Height="36" Foreground="#059669"/>
                        <TextBlock Text="{DynamicResource PdfViewer_Title}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource PdfViewer_Desc}" FontSize="11" Opacity="0.5" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Compress PDF Card -->
                <Button Classes="ToolCard" Click="ToolCard_Click" Tag="Compress" Margin="10">
                    <StackPanel Spacing="15">
                        <PathIcon Data="{StaticResource CompressRegular}" Width="36" Height="36" Foreground="#2563EB"/>
                        <TextBlock Text="{DynamicResource Nav_Compress}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Dash_CompressSub}" FontSize="11" Opacity="0.5" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Edit Metadata Card -->
                <Button Classes="ToolCard" Click="ToolCard_Click" Tag="Metadata" Margin="10">
                    <StackPanel Spacing="15">
                        <PathIcon Data="{StaticResource MetadataRegular}" Width="36" Height="36" Foreground="#D97706"/>
                        <TextBlock Text="{DynamicResource Nav_Metadata}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Dash_MetadataSub}" FontSize="11" Opacity="0.5" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- OCR / Metin Tanıma Card -->
                <Button Classes="ToolCard" Click="ToolCard_Click" Tag="Ocr" Margin="10">
                    <StackPanel Spacing="15">
                        <PathIcon Data="{StaticResource OcrRegular}" Width="36" Height="36" Foreground="#A855F7"/>
                        <TextBlock Text="{DynamicResource Ocr_Title}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Dash_OcrSub}" FontSize="11" Opacity="0.5" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Go Premium Card -->
                <Button Classes="ToolCard" Click="ToolCard_Click" Tag="Premium" Margin="10">
                    <StackPanel Spacing="15">
                        <PathIcon Data="{StaticResource StarRegular}" Width="36" Height="36" Foreground="#F59E0B"/>
                        <TextBlock Text="{DynamicResource Nav_Premium}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Prem_Subtitle}" FontSize="11" Opacity="0.5" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
