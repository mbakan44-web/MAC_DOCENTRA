<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="Docentra_Mac.Views.Pages.WatermarkPage">
    
    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="20,20,20,30">
            <TextBlock Text="{DynamicResource Watermark_Title}" FontSize="28" FontWeight="Black" Foreground="{DynamicResource PremiumAccentBrush}"/>
            <TextBlock Text="{DynamicResource Watermark_Desc}" FontSize="14" Opacity="0.6"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <Grid ColumnDefinitions="*, *" Margin="20,0,20,20">
                <!-- Text Watermark Card -->
                <Border Grid.Column="0" Background="{DynamicResource ToolCardBackground}" CornerRadius="15" Padding="25" BorderBrush="#20FFFFFF" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Top">
                    <StackPanel Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <PathIcon Data="{StaticResource TextRegular}" Foreground="{DynamicResource PremiumAccentBrush}" Width="28" Height="28"/>
                            <TextBlock Text="{DynamicResource Sec_TextWatermark}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Button Click="SelectFile_Click" HorizontalAlignment="Stretch" Padding="15" Background="#10FFFFFF" CornerRadius="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="{StaticResource DocumentSearchRegular}" Width="18" Opacity="0.7"/>
                                <TextBlock x:Name="SelectedFileText" Text="{DynamicResource Gen_SelectFile}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Spacing="8">
                            <TextBlock Text="{DynamicResource Watermark_TextLabel}" Opacity="0.6" FontSize="12" Margin="5,0,0,0"/>
                            <TextBox x:Name="WatermarkText" Watermark="CONFIDENTIAL" Background="#15000000" CornerRadius="10" Padding="12"/>
                        </StackPanel>

                        <Button Content="{DynamicResource Watermark_Apply}" Click="Apply_Click" 
                                Background="{DynamicResource PremiumAccentBrush}" Foreground="Black" FontWeight="Bold"
                                HorizontalAlignment="Stretch" Padding="15" CornerRadius="12"/>
                    </StackPanel>
                </Border>

                <!-- Image Watermark Card -->
                <Border Grid.Column="1" Background="{DynamicResource ToolCardBackground}" CornerRadius="15" Padding="25" BorderBrush="#20FFFFFF" BorderThickness="1" Margin="10,0,0,0" VerticalAlignment="Top">
                    <StackPanel Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <PathIcon Data="{StaticResource ImageRegular}" Foreground="#FBBF24" Width="28" Height="28"/>
                            <TextBlock Text="{DynamicResource Sec_ImageWatermark}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Button Click="SelectImage_Click" HorizontalAlignment="Stretch" Padding="15" Background="#10FFFFFF" CornerRadius="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="{StaticResource ImageAddRegular}" Width="18" Opacity="0.7"/>
                                <TextBlock x:Name="SelectedImageText" Text="{DynamicResource Dash_SignSub}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{DynamicResource Watermark_ImgDesc}" FontSize="12" Opacity="0.5" TextWrapping="Wrap" Margin="5,0,0,0"/>

                        <Button Content="{DynamicResource Watermark_Apply}" Click="OpenImageEditor_Click" 
                                Background="#FBBF24" Foreground="Black" FontWeight="Bold"
                                HorizontalAlignment="Stretch" Padding="15" CornerRadius="12"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>

    <UserControl.Resources>
        <StreamGeometry x:Key="TextRegular">M13 6V18H11V6H5V4H19V6H13Z</StreamGeometry>
        <StreamGeometry x:Key="DocumentSearchRegular">M14 2H6C4.89543 2 4 2.89543 4 4V20C4 21.1046 4.89543 22 6 22H18C19.1046 22 20 21.1046 20 20V8L14 2ZM13 9V3.5L18.5 9H13ZM10.5 13C11.3284 13 12 13.6716 12 14.5C12 14.8219 11.8988 15.1197 11.7262 15.3626L13.8536 17.4899L13.1464 18.197L11.0191 16.0697C10.8647 16.3409 10.5 16.5 10.5 16.5C9.67157 16.5 9 15.8284 9 15C9 14.1716 9.67157 13.5 10.5 13.5V13Z</StreamGeometry>
        <StreamGeometry x:Key="ImageRegular">M19 5V19H5V5H19ZM19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3ZM14.14 11.86L11.14 15.73L9 13.14L6 17H18L14.14 11.86Z</StreamGeometry>
        <StreamGeometry x:Key="ImageAddRegular">M21 19V5C21 3.9 20.1 3 19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19ZM14.14 11.86L11.14 15.73L9 13.14L6 17H18L14.14 11.86Z</StreamGeometry>
    </UserControl.Resources>
</UserControl>
