<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Docentra_Mac.Views.Pages.MergePage">

    <Grid RowDefinitions="Auto, *, Auto" Margin="20">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{DynamicResource Merge_Title}" FontSize="28" FontWeight="Black" Foreground="{DynamicResource PremiumAccentBrush}"/>
            <TextBlock Text="{DynamicResource Merge_Desc}" FontSize="14" Opacity="0.6"/>
        </StackPanel>

        <!-- File List with Premium Look -->
        <Border Grid.Row="1" Background="{DynamicResource ToolCardBackground}" CornerRadius="15" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="10">
            <Grid RowDefinitions="*, Auto">
                <ListBox Grid.Row="0" x:Name="FileList" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Background="#10FFFFFF" CornerRadius="10" Margin="0,2" Padding="12">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <PathIcon Data="{StaticResource DocumentRegular}" Width="20" Height="20" Foreground="{DynamicResource PremiumAccentBrush}" Margin="0,0,15,0"/>
                                    
                                    <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                    
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                        <Button Classes="icon" Click="MoveUp_Click" ToolTip.Tip="Move Up">
                                            <PathIcon Data="{StaticResource ArrowUpRegular}" Width="14"/>
                                        </Button>
                                        <Button Classes="icon" Click="MoveDown_Click" ToolTip.Tip="Move Down">
                                            <PathIcon Data="{StaticResource ArrowDownRegular}" Width="14"/>
                                        </Button>
                                        <Button Classes="icon" Click="RemoveFile_Click" Foreground="#FF4B4B">
                                            <PathIcon Data="{StaticResource DeleteRegular}" Width="14"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                
                <!-- Empty State Message -->
                <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15"
                            IsVisible="{Binding !#FileList.Items.Count}">
                    <PathIcon Data="{StaticResource AddCircleRegular}" Width="60" Height="60" Opacity="0.2"/>
                    <TextBlock Text="{DynamicResource Dash_DragDrop}" FontSize="18" Opacity="0.4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto, *" Margin="0,20,0,0">
            <Button Grid.Column="0" Content="{DynamicResource Merge_Clear}" Click="Clear_Click" 
                    Background="#20FFFFFF" Padding="20,10" CornerRadius="10"/>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="15">
                <Button Content="{DynamicResource Merge_AddFiles}" Click="AddFiles_Click" 
                        Background="#33FFFFFF" Padding="20,10" CornerRadius="10"/>
                <Button Content="{DynamicResource Merge_Start}" Click="Merge_Click" 
                        Background="{DynamicResource PremiumAccentBrush}" Foreground="Black" FontWeight="Bold" Padding="30,10" CornerRadius="10"/>
            </StackPanel>
        </Grid>
    </Grid>

    <UserControl.Resources>
        <StreamGeometry x:Key="DocumentRegular">M14 2H6C4.89543 2 4 2.89543 4 4V20C4 21.1046 4.89543 22 6 22H18C19.1046 22 20 21.1046 20 20V8L14 2ZM13 9V3.5L18.5 9H13Z</StreamGeometry>
        <StreamGeometry x:Key="DeleteRegular">M15 4V3C15 2.44772 14.5523 2 14 2H10C9.44772 2 9 2.44772 9 3V4H4V6H5V19C5 20.6569 6.34315 22 8 22H16C17.6569 22 19 20.6569 19 19V6H20V4H15ZM11 4V4H13V4H11ZM17 19C17 19.5523 16.5523 20 16 20H8C7.44772 20 7 19.5523 7 19V6H17V19Z</StreamGeometry>
        <StreamGeometry x:Key="ArrowUpRegular">M12.7071 3.29289C12.3166 2.90237 11.6834 2.90237 11.2929 3.29289L4.29289 10.2929C3.90237 10.6834 3.90237 11.3166 4.29289 11.7071C4.68342 12.0976 5.31658 12.0976 5.70711 11.7071L11 6.41421V20C11 20.5523 11.4477 21 12 21C12.5523 21 13 20.5523 13 20V6.41421L18.2929 11.7071C18.6834 12.0976 19.3166 12.0976 19.7071 11.7071C20.0976 11.3166 20.0976 10.6834 19.7071 10.2929L12.7071 3.29289Z</StreamGeometry>
        <StreamGeometry x:Key="ArrowDownRegular">M11.2929 20.7071C11.6834 21.0976 12.3166 21.0976 12.7071 20.7071L19.7071 13.7071C20.0976 13.3166 20.0976 12.6834 19.7071 12.2929C19.3166 11.9024 18.6834 11.9024 18.2929 12.2929L13 17.5858V4C13 3.44772 12.5523 3 12 3C11.4477 3 11 3.44772 11 4V17.5858L5.70711 12.2929C5.31658 11.9024 4.68342 11.9024 4.29289 12.2929C3.90237 12.6834 3.90237 13.3166 4.29289 13.7071L11.2929 20.7071Z</StreamGeometry>
        <StreamGeometry x:Key="AddCircleRegular">M12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2ZM11 11H7V13H11V17H13V13H17V11H13V7H11V11Z</StreamGeometry>
    </UserControl.Resources>
</UserControl>
