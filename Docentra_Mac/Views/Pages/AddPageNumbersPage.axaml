<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Docentra_Mac.Views.Pages.AddPageNumbersPage">
    
    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="20,20,20,30">
            <TextBlock Text="{DynamicResource PageNum_Title}" FontSize="28" FontWeight="Black" Foreground="{DynamicResource PremiumAccentBrush}"/>
            <TextBlock Text="{DynamicResource PageNum_Desc}" FontSize="14" Opacity="0.6"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <Grid ColumnDefinitions="*, 300" Margin="20,0,20,20">
                <!-- Left Side Settings -->
                <StackPanel Grid.Column="0" Spacing="20" Margin="0,0,20,0">
                    <Border Background="{DynamicResource ToolCardBackground}" CornerRadius="15" Padding="20" BorderBrush="#20FFFFFF" BorderThickness="1">
                        <StackPanel Spacing="15">
                            <TextBlock Text="{DynamicResource PageNum_StepRange}" FontSize="18" FontWeight="Bold"/>
                            
                            <Button HorizontalAlignment="Stretch" Padding="15" Background="#10FFFFFF" CornerRadius="10" Click="SelectFile_Click">
                                <Grid ColumnDefinitions="Auto, *">
                                    <PathIcon Data="{StaticResource DocumentSearchRegular}" Width="20" Height="20" Foreground="{DynamicResource PremiumAccentBrush}" Margin="0,0,15,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{DynamicResource Sec_SelectPdf}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="SelectedFileText" Text="..." FontSize="11" Opacity="0.5" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Grid ColumnDefinitions="*, *, *">
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="{DynamicResource PageNum_StartPage}" FontSize="12" Opacity="0.6" Margin="5,0,0,5"/>
                                    <NumericUpDown x:Name="NumStart" Value="1" Minimum="1"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="{DynamicResource PageNum_EndPage}" FontSize="12" Opacity="0.6" Margin="5,0,0,5"/>
                                    <NumericUpDown x:Name="NumEnd" Value="1000" Minimum="1"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Start At" FontSize="12" Opacity="0.6" Margin="5,0,0,5"/>
                                    <NumericUpDown x:Name="NumStartValue" Value="1" Minimum="0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*, *">
                        <Border Grid.Column="0" Background="{DynamicResource ToolCardBackground}" CornerRadius="15" Padding="20" BorderBrush="#20FFFFFF" BorderThickness="1" Margin="0,0,10,0">
                            <StackPanel Spacing="15">
                                <TextBlock Text="Format &amp; Position" FontSize="18" FontWeight="Bold"/>
                                <TextBox x:Name="TxtFormat" Watermark="Page {n} of {total}" Background="#15000000" CornerRadius="8"/>
                                <ComboBox x:Name="ComboPosition" SelectedIndex="0" HorizontalAlignment="Stretch" Background="#15000000" CornerRadius="8">
                                    <ComboBoxItem Content="{DynamicResource PageNum_PosBottomCenter}" Tag="BottomCenter"/>
                                    <ComboBoxItem Content="{DynamicResource PageNum_PosBottomRight}" Tag="BottomRight"/>
                                    <ComboBoxItem Content="{DynamicResource PageNum_PosBottomLeft}" Tag="BottomLeft"/>
                                    <ComboBoxItem Content="{DynamicResource PageNum_PosTopCenter}" Tag="TopCenter"/>
                                    <ComboBoxItem Content="{DynamicResource PageNum_PosTopRight}" Tag="TopRight"/>
                                    <ComboBoxItem Content="{DynamicResource PageNum_PosTopLeft}" Tag="TopLeft"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{DynamicResource ToolCardBackground}" CornerRadius="15" Padding="20" BorderBrush="#20FFFFFF" BorderThickness="1" Margin="10,0,0,0">
                            <StackPanel Spacing="15">
                                <TextBlock Text="Font &amp; Style" FontSize="18" FontWeight="Bold"/>
                                <ComboBox x:Name="ComboFont" SelectedIndex="0" HorizontalAlignment="Stretch" Background="#15000000" CornerRadius="8">
                                    <ComboBoxItem Content="Arial"/>
                                    <ComboBoxItem Content="Times New Roman"/>
                                    <ComboBoxItem Content="Courier New"/>
                                    <ComboBoxItem Content="Verdana"/>
                                </ComboBox>
                                <NumericUpDown x:Name="NumFontSize" Value="12" Minimum="6" Maximum="72"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Right Side Color & Action -->
                <StackPanel Grid.Column="1" Spacing="20">
                    <Border Background="{DynamicResource ToolCardBackground}" CornerRadius="15" Padding="20" BorderBrush="#20FFFFFF" BorderThickness="1">
                        <StackPanel Spacing="15">
                            <TextBlock Text="Color" FontSize="18" FontWeight="Bold"/>
                            <WrapPanel x:Name="ColorPalette">
                                <!-- Colors will be generated or styled here -->
                                <Button Width="35" Height="35" Background="Black" CornerRadius="17" Margin="3" Click="Color_Click" Tag="#000000"/>
                                <Button Width="35" Height="35" Background="Red" CornerRadius="17" Margin="3" Click="Color_Click" Tag="#FF0000"/>
                                <Button Width="35" Height="35" Background="Blue" CornerRadius="17" Margin="3" Click="Color_Click" Tag="#0000FF"/>
                                <Button Width="35" Height="35" Background="Green" CornerRadius="17" Margin="3" Click="Color_Click" Tag="#008000"/>
                                <Button Width="35" Height="35" Background="Orange" CornerRadius="17" Margin="3" Click="Color_Click" Tag="#FFA500"/>
                                <Button Width="35" Height="35" Background="White" CornerRadius="17" Margin="3" Click="Color_Click" Tag="#FFFFFF" BorderBrush="Gray" BorderThickness="1"/>
                            </WrapPanel>
                            <TextBlock x:Name="TxtSelectedColor" Text="#000000" HorizontalAlignment="Center" FontSize="12" Opacity="0.5"/>
                        </StackPanel>
                    </Border>

                    <Button Content="ADD PAGE NUMBERS" Click="AddNumbers_Click" 
                            Height="80" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Background="{DynamicResource PremiumGradientBrush}" Foreground="Black" FontWeight="Black" FontSize="18" CornerRadius="15">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    
                    <TextBlock x:Name="StatusText" HorizontalAlignment="Center" FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>

    <UserControl.Resources>
        <StreamGeometry x:Key="DocumentSearchRegular">M14 2H6C4.89543 2 4 2.89543 4 4V20C4 21.1046 4.89543 22 6 22H18C19.1046 22 20 21.1046 20 20V8L14 2ZM13 9V3.5L18.5 9H13ZM10.5 13C11.3284 13 12 13.6716 12 14.5C12 14.8219 11.8988 15.1197 11.7262 15.3626L13.8536 17.4899L13.1464 18.197L11.0191 16.0697C10.8647 16.3409 10.5 16.5 10.5 16.5C9.67157 16.5 9 15.8284 9 15C9 14.1716 9.67157 13.5 10.5 13.5V13Z</StreamGeometry>
    </UserControl.Resources>
</UserControl>
