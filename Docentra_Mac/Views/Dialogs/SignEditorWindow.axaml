<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Docentra_Mac.Views.Dialogs.SignEditorWindow"
        Title="Digital Signature / Image Editor"
        Width="700" Height="900"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

    <Panel>
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial TintColor="#020617" TintOpacity="0.9" MaterialOpacity="0.8" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>

        <Grid RowDefinitions="Auto, *, Auto" Margin="20">
            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,40,0,20">
                <TextBlock Text="IMAGE PLACEMENT EDITOR" FontSize="20" FontWeight="Black" HorizontalAlignment="Center" Foreground="{DynamicResource PremiumAccentBrush}"/>
                <TextBlock Text="Drag and resize the image on the page" FontSize="12" Opacity="0.5" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Preview Area -->
            <Border Grid.Row="1" Background="White" BorderBrush="#33FFFFFF" BorderThickness="1" 
                    Width="450" Height="635" BoxShadow="0 10 30 0 #50000000" VerticalAlignment="Center" ClipToBounds="True">
                <Canvas x:Name="SignCanvas" Background="Transparent"
                        PointerPressed="Canvas_PointerPressed"
                        PointerMoved="Canvas_PointerMoved"
                        PointerReleased="Canvas_PointerReleased">
                    
                    <!-- The Draggable Image -->
                    <Border x:Name="DraggableImageBorder" BorderBrush="{DynamicResource PremiumAccentBrush}" BorderThickness="1"
                            Width="150" Height="100" Canvas.Left="150" Canvas.Top="267" Cursor="Hand">
                        <Grid>
                            <Image x:Name="SignPreviewImage" Stretch="Uniform"/>
                            
                            <!-- Resize Handle (Bottom-Right) -->
                            <Ellipse Width="12" Height="12" Fill="White" Stroke="{DynamicResource PremiumAccentBrush}" StrokeThickness="2"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6" Cursor="BottomRightCorner"
                                     x:Name="ResizeHandle" PointerPressed="Handle_PointerPressed"/>
                        </Grid>
                    </Border>
                </Canvas>
            </Border>

            <!-- Controls -->
            <StackPanel Grid.Row="2" Spacing="15" Margin="20,20,20,0">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Opacity" FontSize="11" Opacity="0.6"/>
                        <Slider x:Name="SldOpacity" Minimum="0" Maximum="100" Value="100" 
                                ValueChanged="Control_ValueChanged"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding #SldOpacity.Value, StringFormat='{}{0:F0}%'}" VerticalAlignment="Bottom" Margin="10,0,0,5" Width="50"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button Content="Cancel" Click="Cancel_Click" Width="100" HorizontalContentAlignment="Center" Background="#20FFFFFF" CornerRadius="10"/>
                    <Button Content="Place Image" Click="Apply_Click" Width="150" HorizontalContentAlignment="Center" Background="{DynamicResource PremiumAccentBrush}" Foreground="Black" CornerRadius="10" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Panel>
</Window>
