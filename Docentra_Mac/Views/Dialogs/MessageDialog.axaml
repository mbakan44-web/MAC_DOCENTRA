<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Docentra_Mac.Views.Dialogs.MessageDialog"
        Title="Docentra PDF Suite"
        Width="400" Height="200"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True"
        SystemDecorations="Full"
        CanResize="False">
    
    <Panel>
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial TintColor="#020617" TintOpacity="0.9" MaterialOpacity="0.8" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>

        <StackPanel Margin="30" Spacing="20" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="15">
                <PathIcon Data="{StaticResource StarRegular}" Foreground="#FBBF24" Width="24" Height="24"/>
                <TextBlock x:Name="MessageText" Text="Your file has been saved. Would you like to open it?" 
                           FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="No / Hayır" Click="No_Click" Width="80" HorizontalContentAlignment="Center" Background="#20FFFFFF"/>
                <Button Content="Yes / Evet" Click="Yes_Click" Width="80" HorizontalContentAlignment="Center" Background="{DynamicResource PremiumAccentBrush}"/>
            </StackPanel>
        </StackPanel>
    </Panel>
</Window>
