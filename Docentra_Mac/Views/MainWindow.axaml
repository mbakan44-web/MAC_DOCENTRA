<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
        x:Class="Docentra_Mac.Views.MainWindow"
        Title="Docentra PDF Suite"
        Width="1100" Height="750"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

    <Panel>
        <Border Background="{DynamicResource MainBackground}" IsHitTestVisible="False"/>

        <Grid ColumnDefinitions="240, *">
            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource GlassBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto, *, Auto">
                    <!-- App Logo/Title -->
                    <StackPanel Grid.Row="0" Margin="25,60,20,30">
                        <TextBlock Text="DOCENTRA" FontSize="24" FontWeight="Black" LetterSpacing="2" Foreground="{DynamicResource PremiumAccentBrush}"/>
                        <TextBlock Text="{DynamicResource Prem_Title}" FontSize="10" FontWeight="Bold" Opacity="0.5" LetterSpacing="1"/>
                    </StackPanel>

                    <!-- Navigation -->
                    <ListBox Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10,0" x:Name="NavList" SelectionChanged="NavList_SelectionChanged">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="15,12"/>
                                <Setter Property="CornerRadius" Value="12"/>
                                <Setter Property="Margin" Value="0,4"/>
                                <Setter Property="Transitions">
                                    <Transitions>
                                        <BrushTransition Property="Background" Duration="0:0:0.2"/>
                                    </Transitions>
                                </Setter>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#15FFFFFF"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource PremiumAccentBrush}"/>
                            </Style>
                        </ListBox.Styles>
                        
                        <!-- Dashboard -->
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <PathIcon Data="{StaticResource HomeRegular}" Width="20" Height="20" Foreground="{DynamicResource PremiumAccentBrush}"/>
                                <TextBlock Text="{DynamicResource Nav_Dashboard}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListBoxItem>
                        
                        <!-- Tools List with Individual Colors -->
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <PathIcon Data="{StaticResource MergeRegular}" Width="20" Height="20" Foreground="#6366F1"/>
                                <TextBlock Text="{DynamicResource Nav_Merge}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <PathIcon Data="{StaticResource SplitRegular}" Width="20" Height="20" Foreground="#F43F5E"/>
                                <TextBlock Text="{DynamicResource Nav_Split}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <PathIcon Data="{StaticResource WatermarkRegular}" Width="20" Height="20" Foreground="#8B5CF6"/>
                                <TextBlock Text="{DynamicResource Watermark_Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <PathIcon Data="{StaticResource LockRegular}" Width="20" Height="20" Foreground="#EC4899"/>
                                <TextBlock Text="{DynamicResource Protect_Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <PathIcon Data="{StaticResource DeleteRegular}" Width="20" Height="20" Foreground="#EF4444"/>
                                <TextBlock Text="{DynamicResource Delete_Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <PathIcon Data="{StaticResource PageNumRegular}" Width="20" Height="20" Foreground="#10B981"/>
                                <TextBlock Text="{DynamicResource PageNum_Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <PathIcon Data="{StaticResource CropRegular}" Width="20" Height="20" Foreground="#06B6D4"/>
                                <TextBlock Text="{DynamicResource Crop_Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <PathIcon Data="{StaticResource SignRegular}" Width="20" Height="20" Foreground="#F59E0B"/>
                                <TextBlock Text="{DynamicResource Sign_Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <PathIcon Data="{StaticResource ConvertRegular}" Width="20" Height="20" Foreground="#6366F1"/>
                                <TextBlock Text="{DynamicResource Conv_Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <!-- PDF Viewer -->
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <PathIcon Data="{StaticResource PdfViewerRegular}" Width="20" Height="20" Foreground="#059669"/>
                                <TextBlock Text="{DynamicResource PdfViewer_Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <!-- Compress PDF -->
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <PathIcon Data="{StaticResource CompressRegular}" Width="20" Height="20" Foreground="#2563EB"/>
                                <TextBlock Text="{DynamicResource Nav_Compress}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <!-- Edit Metadata -->
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <PathIcon Data="{StaticResource MetadataRegular}" Width="20" Height="20" Foreground="#D97706"/>
                                <TextBlock Text="{DynamicResource Nav_Metadata}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <!-- Go Premium -->
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <PathIcon Data="{StaticResource StarRegular}" Width="20" Height="20" Foreground="#D97706"/>
                                <TextBlock Text="{DynamicResource Nav_Premium}" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </ListBoxItem>

                        <!-- Metin Tanıma (OCR) -->
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <PathIcon Data="{StaticResource OcrRegular}" Width="20" Height="20" Foreground="#A855F7"/>
                                <TextBlock Text="{DynamicResource Ocr_Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <!-- Footer -->
                    <StackPanel Grid.Row="2" Margin="15" Spacing="10">
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="15" Padding="15">
                            <Grid ColumnDefinitions="Auto, *">
                                <PathIcon Data="{StaticResource StarRegular}" Foreground="#FBBF24" Width="20" Height="20" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Prem_Title}" FontSize="10" FontWeight="Black" Opacity="0.5"/>
                                    <TextBlock Text="{DynamicResource Prem_DaysRemaining}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <Button HorizontalAlignment="Stretch" Padding="12" Background="Transparent" Click="Settings_Click" CornerRadius="12">
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <PathIcon Data="{StaticResource SettingsRegular}" Width="18" Height="18" Opacity="0.7"/>
                                <TextBlock Text="{DynamicResource Nav_Settings}" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Column="1" RowDefinitions="Auto, *">
                <Border Grid.Row="0" Height="60" Margin="30,40,30,0">
                    <TextBlock x:Name="TxtHeader" Text="{DynamicResource Nav_Dashboard}" FontSize="28" FontWeight="Black" Foreground="{DynamicResource TextForeground}"/>
                </Border>
                <ContentControl Grid.Row="1" x:Name="MainContent"/>
            </Grid>
        </Grid>
    </Panel>
</Window>
