<Application x:Class="PromtAiPdfPro.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Style: All Pages must be transparent to see window color, and enforce dynamic text color -->
            <Style TargetType="Page">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            </Style>
            
            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            </Style>

            <!-- Premium Fluent UI Styles -->
            <LinearGradientBrush x:Key="PremiumGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#20FFFFFF" Offset="0.0"/>
                <GradientStop Color="#0AFFFFFF" Offset="1.0"/>
            </LinearGradientBrush>

            <SolidColorBrush x:Key="DocentraWindowBackground" Color="#1C1C1C"/>
            <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#1C1C1C" Opacity="0.6"/>
            <SolidColorBrush x:Key="PremiumAccentBrush" Color="#0078D4"/>

            <DropShadowEffect x:Key="DropShadowEffect" BlurRadius="15" Opacity="0.3" ShadowDepth="3" Color="Black"/>
            
            <Style x:Key="PremiumCardStyle" TargetType="ui:CardAction">
                <Setter Property="Background" Value="{DynamicResource PremiumGradientBrush}"/>
                <Setter Property="BorderBrush" Value="#30FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="24"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#25FFFFFF"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource PremiumAccentBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PremiumGreenButton" TargetType="ui:Button">
                <Style.Resources>
                    <DropShadowEffect x:Key="ButtonShadow" BlurRadius="12" Opacity="0.3" ShadowDepth="3" Color="#107C10"/>
                </Style.Resources>
                <Setter Property="Height" Value="54"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Effect" Value="{StaticResource ButtonShadow}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ui:Button">
                            <Border x:Name="MainBorder" 
                                    Background="{TemplateBinding Background}" 
                                    CornerRadius="8" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    Effect="{TemplateBinding Effect}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="MainBorder" Property="Opacity" Value="0.6"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="MainBorder" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#0D660D" Offset="0"/>
                                                <GradientStop Color="#1E8A4B" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="MainBorder" Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!-- Base background for the style -->
                    <Trigger Property="IsEnabled" Value="True">
                         <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#107C10" Offset="0"/>
                                    <GradientStop Color="#27AE60" Offset="1"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#107C10" Offset="0"/>
                                    <GradientStop Color="#27AE60" Offset="1"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PremiumHeaderTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="36"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style x:Key="PremiumHeaderSub" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Setter Property="Margin" Value="0,0,0,32"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>


