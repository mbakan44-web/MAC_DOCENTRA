<Window x:Class="PromtAiPdfPro.Views.CheckoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Docentra - Secure Checkout"
        Height="780" Width="980"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        WindowStyle="SingleBorderWindow">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="Docentra Premium - 100% Güvenli Ödeme (Powered by Gumroad)" FontWeight="Bold" FontSize="14"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="Cihaz Kimliğiniz (HWID): " FontSize="12" Opacity="0.7"/>
                            <TextBlock x:Name="TxtHwidBadge" Text="DOC-..." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColorBrush}"/>
                            <TextBlock Text=" · Siparişinize otomatik eklenir." FontSize="12" Opacity="0.7" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnOpenInBrowser" Click="BtnOpenInBrowser_Click" Appearance="Secondary" Margin="0,0,10,0" ToolTip="Tarayıcıda Aç">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Open24" Margin="0,0,6,0"/>
                            <TextBlock Text="Tarayıcıda Aç" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main WebView2 Area -->
        <Grid Grid.Row="1">
            <ui:ProgressRing x:Name="CheckoutLoading" IsIndeterminate="True" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <wv2:WebView2 x:Name="WvCheckout" 
                          Visibility="Hidden"
                          NavigationCompleted="WvCheckout_NavigationCompleted"/>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔒 256-Bit SSL Şifreli Güvenli Ödeme. Kart ve ödeme bilgileriniz doğrudan Gumroad altyapısında işlenir." FontSize="12" Opacity="0.65" VerticalAlignment="Center"/>
                <ui:Button Grid.Column="1" Content="Kapat" Appearance="Subtle" Click="BtnClose_Click" Padding="16,6"/>
            </Grid>
        </Border>
    </Grid>
</Window>
