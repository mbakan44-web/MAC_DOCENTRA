<ui:FluentWindow x:Class="PromtAiPdfPro.Views.PdfReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:forms="clr-namespace:PdfiumViewer;assembly=PdfiumViewer"
        Title="Docentra PDF Suite (Viewer &amp; Editor)" Height="800" Width="1200"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Icon="../Assets/app_icon.ico">
    <Grid Background="{DynamicResource DocentraWindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" 
                      Title="Docentra PDF Suite (Viewer &amp; Editor)"
                      Icon="pack://application:,,,/Assets/app_icon.ico" />

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Tab Header Area -->
                <RowDefinition Height="*" />    <!-- Content Area -->
            </Grid.RowDefinitions>

            <!-- Sekme Çubuğu Alanı -->
            <Grid Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}" Height="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <ui:TabView x:Name="PdfTabView" Grid.Column="0"
                             VerticalAlignment="Top" 
                             Padding="10,0"
                             SelectionChanged="PdfTabView_SelectionChanged" />

                <ui:Button Grid.Column="1" 
                           Icon="{ui:SymbolIcon Add24}" 
                           Appearance="Transparent"
                           Click="BtnNewTab_Click" 
                           Margin="5,0"/>
            </Grid>

            <!-- Sekme İçeriği (Dinamik olarak yüklenecek) -->
            <Grid Grid.Row="1" x:Name="TabContentGrid">
                <!-- Burası seçili sekmenin içeriğini gösterecek -->
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
